{
  "name": "ieeg-electron-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "BrainLens Desktop for EEG analysis with the local Python PyHFO backend.",
  "config": {
    "product_name": "BrainLens Desktop"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "app": "node scripts/launch-electron-app.mjs",
    "app:no-agent": "node scripts/launch-electron-app.mjs --no-agent",
    "electron": "electron .",
    "build": "tsc -p electron/tsconfig.json && tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.js",
    "qa:severity-rail": "node scripts/severity-rail-chart-check.mjs",
    "qa:severity-nav": "node scripts/severity-nav-check.mjs",
    "qa:scrub-timestamps": "node scripts/scrub-timestamp-check.mjs",
    "qa:severity-sync": "node scripts/severity-sync-check.mjs",
    "qa:agent-chat-ui": "node scripts/agent-chat-ui-check.mjs",
    "qa:layout": "node scripts/layout-smoke.mjs",
    "qa:geometry": "node scripts/ui-geometry-audit.mjs",
    "qa:alignment": "node scripts/ui-alignment-audit.mjs",
    "qa:overlay": "node scripts/ui-interaction-overlap-audit.mjs",
    "qa:stateful": "node scripts/ui-stateful-layout-audit.mjs",
    "qa:page-audit": "node scripts/full-app-page-audit.mjs",
    "qa:buttons": "python scripts/button-parity-audit.py",
    "qa:electron-e2e": "node scripts/electron-e2e-smoke.mjs",
    "qa:close-guard": "node scripts/close-guard-smoke.mjs discard && node scripts/close-guard-smoke.mjs save",
    "qa:electron-real-recording": "node scripts/electron-real-recording-smoke.mjs",
    "qa:user-journey": "node scripts/electron-full-user-journey.mjs",
    "qa:user-journey-batch": "node scripts/electron-journey-batch.mjs",
    "qa:agent-supervisor": "node scripts/electron-agent-supervisor-smoke.mjs",
    "qa:copilot-live": "node scripts/electron-copilot-live-smoke.mjs",
    "qa:chat-flow": "node scripts/agent-chat-flow-smoke.mjs",
    "qa:chat-edgecases": "node scripts/agent-chat-edgecases-smoke.mjs",
    "qa:ui-e2e": "node scripts/agent-ui-e2e-screens.mjs",
    "qa:copilot-deep": "node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-journey": "COPILOT_DEEP_PROFILE=journey node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-guards": "COPILOT_DEEP_PROFILE=guards node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-navigate": "COPILOT_DEEP_PROFILE=navigate node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-biomarkers": "COPILOT_DEEP_PROFILE=biomarkers node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-compare": "COPILOT_DEEP_PROFILE=compare node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-batch": "COPILOT_DEEP_PROFILE=batch node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-full": "COPILOT_DEEP_PROFILE=full node scripts/electron-copilot-deep-e2e.mjs",
    "qa:copilot-demo": "node scripts/electron-copilot-demo.mjs",
    "qa:agent-video": "node scripts/electron-copilot-agent-video.mjs",
    "qa:llm-key": "node scripts/electron-llm-key-smoke.mjs",
    "qa:ui-mcp": "node scripts/electron-ui-mcp-smoke.mjs",
    "qa:ui-mcp-sweep": "node scripts/electron-ui-mcp-sweep.mjs",
    "qa:copilot-payload-eval": "node scripts/electron-copilot-payload-eval.mjs",
    "qa:apple2apple": "node scripts/electron-apple2apple-smoke.mjs",
    "qa:interactions": "node scripts/product-interaction-audit.mjs",
    "qa:real-fixture": "node scripts/real-fixture-smoke.mjs",
    "qa:packaged": "node scripts/packaged-electron-smoke.mjs",
    "qa:packaged-severity": "node scripts/packaged-severity-smoke.mjs",
    "qa:montage": "node scripts/montage-behavior-check.mjs",
    "qa:packaged-cold-start": "node scripts/packaged-cold-start-smoke.mjs",
    "qa:hf-onnx-runtime": "node scripts/hf-onnx-runtime-smoke.mjs",
    "qa:signoff": "node scripts/production-signoff-audit.mjs",
    "qa:production-parity": "npm run typecheck && npm run build && npm run qa:layout && npm run qa:geometry && npm run qa:overlay && npm run qa:stateful && npm run qa:buttons && npm run qa:electron-e2e && npm run qa:electron-real-recording && npm run qa:close-guard && npm run qa:interactions && npm test -- --runInBand && PYTHONPATH=../pyhfo/src python -m pytest ../pyhfo/tests/test_electron_parity_fixture_smoke.py -q",
    "package:mac-smoke": "npm run build && node scripts/package-macos-app.mjs && export PYHFO_PARITY_ELECTRON_APP=\"${PYHFO_PACKAGE_OUTPUT_APP:-artifacts/packaged/$npm_package_config_product_name.app}\" && npm run qa:packaged && npm run qa:packaged-cold-start && npm run qa:hf-onnx-runtime",
    "package:backend-win": "python -m PyInstaller --noconfirm --clean ../pyhfo/pyhfo_windows.spec --distpath ../pyhfo/dist --workpath ../pyhfo/build",
    "package:agent-runtime-win": "python -m PyInstaller --noconfirm --clean ../runtime/ieeg_agent_runtime_windows.spec --distpath ../runtime/dist --workpath ../runtime/build",
    "build:python": "node scripts/build-python-binaries.mjs",
    "verify:python": "node scripts/verify-python-binaries.mjs",
    "package:win": "npm run verify:python && npm run build && electron-builder --win --config electron-builder.yml",
    "package:win-portable": "npm run build && electron-builder --win portable --config electron-builder.yml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.60.0"
  }
}
